# Required server-only configuration
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database
JWT_SECRET=replace-with-a-long-random-secret

# Required only for contact and serve-form email delivery
EMAIL_USER=sender@example.com
EMAIL_PASS=replace-with-an-app-password
EMAIL_TO=recipient@example.com
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587

# Required only by the self-hosted Sunday sermon import job
ADMIN_USERNAME=admin-username
ADMIN_PASSWORD=admin-password

# Optional for self-hosting; Vercel supplies PORT automatically
PORT=3001
